# MongoDB Connection String
# Get this from MongoDB Atlas (free): https://www.mongodb.com/cloud/atlas
# Steps:
# 1. Go to https://www.mongodb.com/cloud/atlas
# 2. Sign up (free tier available)
# 3. Create a free cluster
# 4. Click "Connect" → "Drivers" → copy the connection string
# 5. Replace <username>, <password>, and cluster name in the URI below
# 6. Paste your connection string here and restart the backend

MONGO_URI=mongodb://localhost:27017/finsight

# JWT Secret Key for authentication (generate a random string for production)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Email SMTP Settings (optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_FROM=your_email@gmail.com

# Optional APIs
GOLD_API_KEY=your_metalpriceapi_key
